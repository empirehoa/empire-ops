# ---- Required ----
# Empire Ops' own Supabase project (not Vera's). Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Who can sign in (comma-separated work emails).
ADMIN_EMAILS=jrriestra@empirehoa.com

# Shared secret for the daily run and /api/sync, /api/automation endpoints.
# Generate: openssl rand -base64 32
AUTOMATION_SECRET=
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on the daily cron.
# Without it, /api/cron/run-all refuses every request.
CRON_SECRET=

# Encrypts stored QuickBooks tokens. 32 random bytes, base64.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Public URL of this deployment (used by the daily run to call each agent).
NEXT_PUBLIC_APP_URL=https://empire-ops.vercel.app

# ---- Data sources ----
# HubSpot private app token. Scopes: crm.objects.deals.read, crm.objects.owners.read
HUBSPOT_ACCESS_TOKEN=

# QuickBooks Online app (developer.intuit.com). Redirect URI must match exactly.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://empire-ops.vercel.app/api/integrations/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=production

# ---- Delivery (optional) ----
DISCORD_WEBHOOK_URL=
NOTION_API_KEY=
NOTION_INTELLIGENCE_PAGE_ID=
SENTRY_DSN=
